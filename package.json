{
  "name": "saucedemo-qa-assignment",
  "version": "1.0.0",
  "description": "Playwright UI and API tests: saucedemo.com and restful-booker",
  "scripts": {
    "test": "playwright test --project=ui --project=api",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:generated": "playwright test --project=generated-ui --project=generated-api",
    "pipeline": "node pipeline/generate.mjs"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
